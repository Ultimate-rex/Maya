# Copy this file to .env and fill in your real values. Never commit .env.

# Pick one or both LLM providers - only the one selected in settings/llm_settings.json is used
GEMINI_API_KEY=
GROQ_API_KEY=

# Used for Whisper STT and TTS voice synthesis
OPENAI_API_KEY=

# Long random string the Android app must send as "Authorization: Bearer <this>"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAYA_ACCESS_TOKEN=
